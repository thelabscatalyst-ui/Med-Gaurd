# Copy to .env for local runs. Real values for staging/production live in Secret Manager.
ENVIRONMENT=local
LOG_LEVEL=INFO

# MedGuard's own database (local Docker: `docker compose up -d db`)
DATABASE_URL=postgresql://medguard:medguard@localhost:5433/medguard
# Admin connection for migrations only (creates tables, roles, policies). Locally the same
# superuser; in the cloud a separate secret the running app never sees.
MIGRATIONS_DATABASE_URL=postgresql://medguard:medguard@localhost:5433/medguard
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
